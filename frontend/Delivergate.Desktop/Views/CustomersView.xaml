<UserControl x:Class="Delivergate.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Customer access" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Your role permits the following customer actions:" Margin="0,12,0,16" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding CustomerPermissions}" AutomationProperties.Name="Customer permissions">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Action}" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Separator Margin="0,8,0,16" />
        <TextBlock Text="Customer listing, search, and create/edit/delete workflows will be added in F7."
                   TextWrapping="Wrap" />
        <TextBlock Text="No customer data has been loaded on this screen yet."
                   Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
