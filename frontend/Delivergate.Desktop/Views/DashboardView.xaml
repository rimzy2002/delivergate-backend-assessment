<UserControl x:Class="Delivergate.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Welcome" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding UserName}" Margin="0,8,0,16" TextWrapping="Wrap" />
        <TextBlock Text="Use Inventory to manage stock, or Customers to manage customer records."
                   TextWrapping="Wrap" />
        <Border BorderBrush="#D5D5D5" BorderThickness="1" Padding="16" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Your access" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Role, StringFormat=Signed in as: {0}}" Margin="0,8,0,8" />
                <TextBlock Text="Each section shows which actions your role permits. The backend verifies permissions on every request."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Text="Inventory and customer workflows are ready. Available actions depend on your role. No live totals are shown yet."
                   TextWrapping="Wrap" Margin="0,20,0,0" />
    </StackPanel>
</UserControl>
