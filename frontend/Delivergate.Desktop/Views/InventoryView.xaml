<UserControl x:Class="Delivergate.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="EditorVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <WrapPanel Margin="0,0,0,12">
            <Button Content="_New item" Click="New_Click" IsEnabled="{Binding CanCreate}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="_Edit selected" Click="Edit_Click" IsEnabled="{Binding CanEdit}" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="_Delete selected" Click="Delete_Click" IsEnabled="{Binding CanDelete}" Padding="12,6" />
        </WrapPanel>
        <Border BorderBrush="#D5D5D5" BorderThickness="1" Padding="12" Margin="0,0,0,16"
                Visibility="{Binding IsEditing, Converter={StaticResource EditorVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <StackPanel IsEnabled="{Binding CanCancelEdit}">
                    <Label Content="Item name" Target="{Binding ElementName=ItemName}" />
                    <TextBox x:Name="ItemName" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Padding="6" />
                    <Label Content="Description (optional)" Target="{Binding ElementName=ItemDescription}" />
                    <TextBox x:Name="ItemDescription" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" />
                    <Label Content="Category" Target="{Binding ElementName=ItemCategory}" />
                    <ComboBox x:Name="ItemCategory" ItemsSource="{Binding EditorCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding EditCategoryId, Mode=TwoWay}" Padding="6" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0">
                            <Label Content="Price (example: 125.50)" Target="{Binding ElementName=ItemPrice}" />
                            <TextBox x:Name="ItemPrice" Text="{Binding EditPrice, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="6" />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Quantity" Target="{Binding ElementName=ItemQuantity}" />
                            <TextBox x:Name="ItemQuantity" Text="{Binding EditQuantity, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="6" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="_Save item" Click="Save_Click" IsEnabled="{Binding CanSave}" Padding="12,6" Margin="0,0,12,0" />
                    <Button Content="Cancel edit" Click="Cancel_Click" IsEnabled="{Binding CanCancelEdit}" Padding="12,6" />
                </WrapPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <WrapPanel IsEnabled="{Binding CanFilter}">
            <StackPanel Margin="0,0,16,12">
                <Label Content="Search by item _name" Target="{Binding ElementName=SearchBox}" />
                <TextBox x:Name="SearchBox" Width="200" Padding="6" MaxLength="150"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search inventory by name" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <Label Content="Cate_gory" Target="{Binding ElementName=CategoryFilter}" />
                <ComboBox x:Name="CategoryFilter" Width="180" Padding="6"
                          ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                          AutomationProperties.Name="Filter inventory by category" />
            </StackPanel>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,12">
            <Button Content="_Refresh" Click="Refresh_Click" Padding="12,6" Margin="0,0,12,0" IsEnabled="{Binding CanLoad}" />
            <Button Content="Clear _filters" Click="ClearFilters_Click" Padding="12,6" IsEnabled="{Binding CanFilter}" />
        </WrapPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding ResultSummary}" Margin="0,0,0,12" FontWeight="SemiBold" />
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsEnabled="{Binding CanFilter}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" Height="260" MinWidth="200"
                  EnableRowVirtualization="True" HeadersVisibility="Column" AutomationProperties.Name="Inventory items">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="85" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Selected item description" FontWeight="SemiBold" Margin="0,16,0,6" />
        <TextBlock Text="{Binding SelectedItem.Description, TargetNullValue=Select an item to view its description.}"
                   TextWrapping="Wrap" />
        <Expander Header="Your inventory permissions" Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding DataContext.Workspace.InventoryPermissions, RelativeSource={RelativeSource AncestorType=Window}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{Binding Action}" Width="120" />
                            <TextBlock Text="{Binding Status}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
        <TextBlock Text="Select a row to edit or delete it. Available actions depend on your role."
                   TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
