<Window x:Class="Delivergate.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Delivergate.Desktop.Views"
        Title="Delivergate - Shop Management"
        Width="1100"
        Height="760"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Foreground="#222222"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Delivergate"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <TextBlock Text="Ice cream shop management"
                       Margin="0,6,0,20" />

            <Separator />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
            <StackPanel Margin="0,0,16,0">
                <StackPanel Visibility="{Binding Auth.IsSignedOut, Converter={StaticResource BoolVisibility}}"
                            IsEnabled="{Binding Auth.CanInteract}">
                    <TextBlock Text="Sign in" FontSize="20" FontWeight="SemiBold" />
                    <Label Content="_Email" Target="{Binding ElementName=LoginEmail}" Margin="0,12,0,0" />
                    <TextBox x:Name="LoginEmail" Text="{Binding Auth.Email, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="254" Padding="8" MaxWidth="420" HorizontalAlignment="Left"
                             Width="350" AutomationProperties.Name="Email" />
                    <Label Content="_Password" Target="{Binding ElementName=LoginPassword}" Margin="0,10,0,0" />
                    <PasswordBox x:Name="LoginPassword" Padding="8" Width="350" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Password" />
                    <Button Content="_Sign in" Click="Login_Click" Padding="20,8" Margin="0,16,0,0"
                            HorizontalAlignment="Left" IsDefault="True" />
                </StackPanel>

                <StackPanel Visibility="{Binding Auth.IsSignedIn, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="{Binding Auth.UserName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Auth.UserEmail}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Role: " FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Auth.UserRole}" />
                    </StackPanel>
                    <WrapPanel Margin="0,16,0,0" IsEnabled="{Binding Auth.CanInteract}">
                        <Button Content="_Verify session" Click="VerifySession_Click" Padding="16,8" Margin="0,0,12,8" />
                        <Button Content="Sign _out" Click="Logout_Click" Padding="16,8" Margin="0,0,0,8" />
                    </WrapPanel>
                    <Grid Margin="0,12,0,8" DataContext="{Binding Workspace}"
                          Visibility="{Binding CanOpenWorkspace, Converter={StaticResource BoolVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" KeyboardNavigation.TabNavigation="Continue">
                            <TextBlock Text="Navigation" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <RadioButton Content="_Dashboard" GroupName="Navigation" Margin="0,0,0,16"
                                         IsChecked="{Binding IsDashboard, Mode=OneWay}" Click="Dashboard_Click" />
                            <RadioButton Content="_Inventory" GroupName="Navigation" Margin="0,0,0,16"
                                         IsChecked="{Binding IsInventory, Mode=OneWay}" Click="Inventory_Click"
                                         IsEnabled="{Binding Permissions.CanViewInventory}" />
                            <RadioButton Content="C_ustomers" GroupName="Navigation" Margin="0,0,0,16"
                                         IsChecked="{Binding IsCustomers, Mode=OneWay}" Click="Customers_Click"
                                         IsEnabled="{Binding Permissions.CanViewCustomers}" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="#D5D5D5" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"
                                           AutomationProperties.LiveSetting="Polite" />
                                <views:DashboardView Visibility="{Binding IsDashboard, Converter={StaticResource BoolVisibility}}" />
                                <views:InventoryView
                                    DataContext="{Binding DataContext.Inventory, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding DataContext.Workspace.IsInventory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                                <views:CustomersView
                                    DataContext="{Binding DataContext.Customers, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding DataContext.Workspace.IsCustomers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding Auth.Message}" Margin="0,16,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Your session is kept only while this app is open."
                           FontSize="12" Margin="0,8,0,20" TextWrapping="Wrap" />
                <Separator />
                <TextBlock Text="Backend connection" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBlock Text="{Binding ApiBaseUrl}" TextWrapping="Wrap" />
                <Button Content="_Check connection" HorizontalAlignment="Left" Padding="16,6" Margin="0,10,0,0"
                        IsEnabled="{Binding CanCheckConnection}" Click="CheckConnection_Click" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="_Close"
                HorizontalAlignment="Right"
                Padding="20,6"
                Click="Close_Click" />
    </Grid>
</Window>
