<Window x:Class="Delivergate.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivergate - Shop Management"
        Width="820"
        Height="760"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Foreground="#222222"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Delivergate"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <TextBlock Text="Ice cream shop management"
                       Margin="0,6,0,20" />

            <Separator />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
            <StackPanel Margin="0,0,16,0">
                <StackPanel Visibility="{Binding Auth.IsSignedOut, Converter={StaticResource BoolVisibility}}"
                            IsEnabled="{Binding Auth.CanInteract}">
                    <TextBlock Text="Sign in" FontSize="20" FontWeight="SemiBold" />
                    <Label Content="_Email" Target="{Binding ElementName=LoginEmail}" Margin="0,12,0,0" />
                    <TextBox x:Name="LoginEmail" Text="{Binding Auth.Email, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="254" Padding="8" MaxWidth="420" HorizontalAlignment="Left"
                             Width="350" AutomationProperties.Name="Email" />
                    <Label Content="_Password" Target="{Binding ElementName=LoginPassword}" Margin="0,10,0,0" />
                    <PasswordBox x:Name="LoginPassword" Padding="8" Width="350" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Password" />
                    <Button Content="_Sign in" Click="Login_Click" Padding="20,8" Margin="0,16,0,0"
                            HorizontalAlignment="Left" IsDefault="True" />
                </StackPanel>

                <StackPanel Visibility="{Binding Auth.IsSignedIn, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Signed in" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Auth.UserName}" FontSize="18" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Auth.UserEmail}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Role: " FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Auth.UserRole}" />
                    </StackPanel>
                    <TextBlock Text="Inventory and customer screens will be added in the next stages."
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                    <WrapPanel Margin="0,16,0,0" IsEnabled="{Binding Auth.CanInteract}">
                        <Button Content="_Verify session" Click="VerifySession_Click" Padding="16,8" Margin="0,0,12,8" />
                        <Button Content="Sign _out" Click="Logout_Click" Padding="16,8" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>

                <TextBlock Text="{Binding Auth.Message}" Margin="0,16,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Your session is kept only while this app is open."
                           FontSize="12" Margin="0,8,0,20" TextWrapping="Wrap" />
                <Separator />
                <TextBlock Text="Backend connection" FontWeight="SemiBold" Margin="0,16,0,6" />
                <TextBlock Text="{Binding ApiBaseUrl}" TextWrapping="Wrap" />
                <Button Content="_Check connection" HorizontalAlignment="Left" Padding="16,6" Margin="0,10,0,0"
                        IsEnabled="{Binding CanCheckConnection}" Click="CheckConnection_Click" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="_Close"
                HorizontalAlignment="Right"
                Padding="20,6"
                Click="Close_Click" />
    </Grid>
</Window>
